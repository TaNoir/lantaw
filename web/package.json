{
  "name": "lantaw-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:engine": "wasm-pack build ../engine --target web --release --out-dir ../web/src/lib/wasm-pkg",
    "dev": "npm run build:engine && vite",
    "build": "npm run build:engine && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "dexie": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
